{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Отладка парсера (WSL / GDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/linux/spo-parser",
      "args": [
        "examples/basic.spo",
        "build/linux/debug.dot"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Удобный просмотр структур",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "make: build",
      "visualizerFile": "${workspaceFolder}/.vscode/ast.natvis",
      "showDisplayString": true
    }
  ]
}
