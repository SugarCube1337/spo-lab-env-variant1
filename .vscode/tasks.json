{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "make: build",
      "type": "shell",
      "command": "make",
      "args": [
        "all"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "make: check",
      "type": "shell",
      "command": "make",
      "args": [
        "check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "make: visualize",
      "type": "shell",
      "command": "make",
      "args": [
        "visualize"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Собрать AST и картинку SVG"
    }
  ]
}
